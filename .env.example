# KickoffCal

NEXT_PUBLIC_APP_URL=http://127.0.0.1:43123

# Optional — enable magic-link auth + synced favorites (Supabase Auth + Postgres)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only — required for Stripe webhooks, API key issuance, and MCP favorites
SUPABASE_SERVICE_ROLE_KEY=

# Optional — Stripe Checkout for KickoffCal Pro ($2/mo or $15/yr)
# Create two Prices in Stripe Dashboard (same Product is fine):
#   Monthly: $2 USD / month  → STRIPE_PRICE_ID_MONTHLY=price_...
#   Yearly:  $15 USD / year  → STRIPE_PRICE_ID_YEARLY=price_...
# Checkout applies subscription_data.trial_period_days=14 for both plans.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID_MONTHLY=
STRIPE_PRICE_ID_YEARLY=
# Legacy alias for monthly only (optional if STRIPE_PRICE_ID_MONTHLY is set)
# STRIPE_PRICE_ID=
# Stripe Dashboard → Developers → Webhooks → Add endpoint:
#   https://kickoffcal.vercel.app/api/stripe/webhook
# Events: checkout.session.completed, customer.subscription.updated,
#         customer.subscription.deleted, invoice.paid, invoice.payment_failed
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Fallback when Checkout Price IDs are not set (single Payment Link)
NEXT_PUBLIC_STRIPE_PAYMENT_LINK=

# Optional — signing secret for local/mock MCP API keys (falls back to CRON_SECRET)
MCP_API_KEY_SECRET=

# Optional — protect /api/sync (Vercel Cron sends Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=
